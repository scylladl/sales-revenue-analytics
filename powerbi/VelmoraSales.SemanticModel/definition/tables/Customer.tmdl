/// Customers: HoReCa accounts, retail stores (one customer per store) and consumers.
table Customer
	lineageTag: 37b44939-9982-5050-97b9-9336994a3bf2

	column 'Customer Key'
		dataType: int64
		isHidden
		lineageTag: af8600ba-b143-563d-b25c-0f2c727af7d1
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Explicit

	column 'Customer Id'
		dataType: string
		lineageTag: 8db00655-83c8-5321-a193-91e9a35c569d
		summarizeBy: none
		sourceColumn: CustomerId

		annotation SummarizationSetBy = Explicit

	column Customer
		dataType: string
		lineageTag: 36f77a8e-0646-56e6-9ccb-ed5ba957f4f1
		summarizeBy: none
		sourceColumn: CustomerName

		annotation SummarizationSetBy = Explicit

	/// HoReCa tier (Gold, Silver, Bronze), retail Chain or Gourmet, e-commerce Consumer.
	column Segment
		dataType: string
		lineageTag: 694caeee-6232-5ef8-ba7a-0f930de49d5c
		summarizeBy: none
		sourceColumn: Segment

		annotation SummarizationSetBy = Explicit

	column City
