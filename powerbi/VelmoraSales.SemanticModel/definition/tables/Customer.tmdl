		lineageTag: 0475f9c3-9939-5132-89ff-22aac70dc184
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = Explicit

	column 'Created Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: ca972952-90ad-5baf-9e09-d04a2ada1cdc
		summarizeBy: none
		sourceColumn: CreatedDate

		annotation SummarizationSetBy = Explicit

	/// Same channel, name and city as another customer id (check SRC-01); kept separate until the sales team decides.
	column 'Is Possible Duplicate'
		dataType: boolean
		lineageTag: ea456c4d-3329-571e-ad7e-7ae919fb5583
		summarizeBy: none
		sourceColumn: IsPossibleDuplicate

		annotation SummarizationSetBy = Explicit

	partition Customer = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database ( Server, Database ),
				    Data = Source{[Schema = "rpt", Item = "vw_Customer"]}[Data],
				    Typed = Table.TransformColumnTypes ( Data, {{"CustomerKey", Int64.Type}} )
				in
				    Typed

	annotation PBI_ResultType = Table
