/// One row per invoice line and per credit note line (rules R1 to R5). Amounts exclude VAT. Return rows carry a negative quantity and net revenue; Posting Date is the invoice or credit note date.
table Sales
	lineageTag: e5cd264f-adf9-540a-a579-31e53645dea9

	column 'Order Id'
		dataType: string
		isHidden
		lineageTag: 945bbaa7-6dba-579a-a778-5107fe4f14bb
		summarizeBy: none
		sourceColumn: OrderId

		annotation SummarizationSetBy = Explicit

	/// Invoice or Return.
	column 'Line Type'
		dataType: string
		lineageTag: 9a5e913b-b0aa-563d-bbca-9dcfff3543af
		summarizeBy: none
		sourceColumn: LineType

		annotation SummarizationSetBy = Explicit

	column 'Posting Date'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 1ba9d94b-afa4-5b9e-b5a8-30381a097754
		summarizeBy: none
		sourceColumn: PostingDate

		annotation SummarizationSetBy = Explicit

	/// Invoice date of the sale; on return rows it attributes the return to the original sale (inactive relationship).
	column 'Original Invoice Date'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 9728c043-1520-5ae1-a755-f20f4f0710d8
		summarizeBy: none
		sourceColumn: OriginalInvoiceDate

		annotation SummarizationSetBy = Explicit

