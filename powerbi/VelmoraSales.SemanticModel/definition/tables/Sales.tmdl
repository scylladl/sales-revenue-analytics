	/// Gross sales x (line discount % - contract maximum % of the customer's segment), on checked lines (CR-01).
	column 'Discount Above Policy'
		dataType: decimal
		isHidden
		formatString: #,##0.00
		lineageTag: 65cb3150-17f8-5c0b-824f-54d7988abeee
		summarizeBy: none
		sourceColumn: DiscountAbovePolicy

