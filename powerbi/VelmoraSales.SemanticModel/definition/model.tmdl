model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

queryGroup Facts

	annotation PBI_QueryGroupOrder = 2

queryGroup Support

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Server","Database","Budget File","Budget Sheets","Date","Channel","Region","Category","Customer","Product","Sales","Order Line","Data Quality Check","Processing Status","Budget","Budget Workbook Total"]

ref table Date
ref table Channel
ref table Region
ref table Category
ref table Customer
ref table Product
ref table Sales
ref table 'Order Line'
ref table 'Data Quality Check'
ref table 'Processing Status'
ref table Budget
ref table 'Budget Workbook Total'
ref table _Measures
